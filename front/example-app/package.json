{
  "name": "gally-features-example",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@elastic-suite/gally-sdk": "^2.3.1",
    "i18next": "^23.11.5",
    "ionicons": "6.0.3",
    "next": "^16.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^14.1.3"
  },
  "scripts": {
    "start": "next dev -p 3001",
    "build": "next build",
    "serve": "next start -p 3001",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "eslint": "eslint --fix .",
    "eslint:ci": "eslint .",
    "prettier": "prettier --write --ignore-unknown --ignore-path .gitignore .",
    "prettier:ci": "prettier --check --ignore-unknown --ignore-path .gitignore .",
    "typescript": "next typegen && tsc --noEmit",
    "typescript:ci": "next typegen && tsc --noEmit",
    "test:watch": "vitest",
    "test:capture-fixtures": "CAPTURE_FIXTURES=1 vitest run src/test/fixtures/capture-api.test.ts"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "2.7.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7"
  }
}
